# Copy this file to ".env". It decides which AI picks the moments.

# --- Basic scoring (default, no API key needed) ---
AI_PROVIDER=none

# --- Optional local model through Ollama ---
# AI_PROVIDER=ollama
# OLLAMA_MODEL=qwen3.5:4b
# Only needed if ollama isn't on your PATH or you keep models in a custom folder:
# OLLAMA_EXE=C:\path\to\ollama.exe
# OLLAMA_MODELS=D:\ollama-models

# --- Google Gemini: free tier, fast. Key: https://aistudio.google.com/apikey ---
# AI_PROVIDER=gemini
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash-lite

# --- Anthropic Claude: paid ---
# AI_PROVIDER=claude
# ANTHROPIC_API_KEY=

# --- Custom OpenAI-compatible model ---
# AI_PROVIDER=custom
# CUSTOM_AI_ENDPOINT=http://127.0.0.1:20128/v1
# CUSTOM_AI_MODEL=
# CUSTOM_AI_API_KEY=

# --- Hosted presets (each uses its own key) ---
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openrouter/free
# NVIDIA_API_KEY=
# NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b

# --- No AI: rule-based scoring ---
# AI_PROVIDER=none

# Whisper model for videos without YouTube captions: tiny, base, small, medium
# WHISPER_MODEL=small

# --- YouTube posting (optional) — see docs/youtube-setup.md ---
# YOUTUBE_CLIENT_ID=
# YOUTUBE_CLIENT_SECRET=
